@using Fanex.NAP.SMATurnoverEmailService.Entities
@model IEnumerable<FormattedSMATurnover>
<style type="text/css">
    body {
        font-family: Tahoma, Arial, Verdana, Sans-Serif;
        color: #333;
    }
    .table-wraper {
        max-height: 200px;
        width: 1170px;
        overflow-y: auto;
    }
    .table {
        border-color: #CECCCD;
        border-style: Solid;
    }
    .head-row {
        background-color:#7A97D1;
        font-weight: bold;
    }
    .not-reply {
        font-style: italic;
        font-weight: bold;
    }
</style>
<div>
    <div>
        <br />
        <p></p>Dear All,</p>
        <br /><br />
        <p>Please be notified that SMA(s) listed in the table below have reached the Maximum Turnover value.</p>
        <br /><br />
        <p>Please check and carry out timely actions accordingly</p>
    </div>
    <br />
    <div class="table-wraper">
        <table cellspacing="0" border="1" border="1" rules="all" class="table">
            <thead>
                <tr class="head-row">
                    <td align="center" style="width: 100px">Sport</td>
                    <td align="center" style="width: 200px">League</td>
                    <td align="center" style="width: 100px">Match Code</td>
                    <td align="center" style="width: 200px">Event</td>
                    <td align="center" style="width: 100px">Event Date</td>
                    <td align="center" style="width: 100px">SMA Name</td>
                    <td align="center" style="width: 70px">Currency</td>
                    <td align="center" style="width: 100px">Member Turnover</td>
                    <td align="center" style="width: 100px">Max Turnover</td>
                    <td align="center" style="width: 100px">Percentage Used</td>
                </tr>
            </thead>
            <tbody>
                @foreach (FormattedSMATurnover data in @Model)
                {
                    <tr>
                        <td align="center" style="width: 100px">@data.SportName</td>
                        <td align="left" style="width: 200px">@data.LeagueName</td>
                        <td align="center" style="width: 100px">@data.MatchCode</td>
                        <td align="left" style="width: 200px">@data.MatchName</td>
                        <td align="center" style="width: 100px">@data.EventDate</td>
                        <td align="left" style="width: 100px">@data.Username</td>
                        <td align="center" style="width: 70px">@data.Currency</td>
                        <td align="right" style="width: 100px">@data.MaxTOAmount</td>
                        <td align="right" style="width: 100px">@data.MemberTO</td>
                        <td align="right" style="width: 100px">@data.PercentageUsed</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <br /><br />
    <p>Regards.</p>
    <br /><br />
    <p class="not-reply">This is an auto-mail. Please do not reply.</p>
</div>