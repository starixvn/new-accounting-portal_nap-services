@using Fanex.NAP.SMALossEmail.Watcher.Entities
@model IEnumerable<FormattedSMALossGroup>
<div style="color: #333; font-family: arial,sans-serif; font-size: 12px;">
    <div>
        <p>Dear All,</p>
        <p>Please be notified that SMA(s) listed in the table below have reached the Maximum Loss value.</p>
        <p>Please check and take timely actions accordingly</p>
    </div>
    <br />
    <div style="max-height: 600px; width: 880px; overflow-y: auto;">
        <table cellspacing="0" border="1" border="1" rules="all" style="border-color: #c5c5c5; border-style: solid; color: #333; font-family: arial,sans-serif; font-size: 12px;">
            <thead>
                <tr style="background-color: #3c5ea5; color: #fff; height: 25px;">
                    <td align="center" style="width: 70px">#</td>
                    <td align="center" style="width: 220px">SMA Name</td>
                    <td align="center" style="width: 85px">Level</td>
                    <td align="center" style="width: 60px">Currency</td>
                    <td align="center" style="width: 120px">Yesterday Balance</td>
                    <td align="center" style="width: 120px">Total Balance</td>
                    <td align="center" style="width: 120px">Max Loss</td>
                    <td align="center" style="width: 105px">Loss Percentage</td>
                </tr>
            </thead>
            <tbody>
                @{
                    int counter = 0;

                    foreach (FormattedSMALossGroup group in Model)
                    {
                        var levelColor = "#000";

                        if (group.LossLevel == 1)
                        {
                            levelColor = "#4F1777";
                        }
                        else if (group.LossLevel == 2)
                        {
                            levelColor = "#0D7F00";
                        }
                        else if (group.LossLevel == 3)
                        {
                            levelColor = "#1058C2";
                        }
                        else if (group.LossLevel == 4)
                        {
                            levelColor = "#FF6D1B";
                        }
                        else if (group.LossLevel == 5)
                        {
                            levelColor = "#D9127A";
                        }
                        else if (group.LossLevel == 6)
                        {
                            levelColor = "#D20001";
                        }
                        <tr style="height: 25px; background-color: #f1f1f1">
                            <td style="color: @levelColor; font-weight: bold"colspan="8">@group.LossLevelRange (@group.SMALossItems.Count)</td>
                        </tr>

                        foreach (FormattedSMALossItem data in group.SMALossItems)
                        {
                            var icon = string.Empty;
                            var iconAlt = string.Empty;

                            counter++;

                            if (data.ChangedLevel > 0) {
                                icon = "lruworradrawpu";
                                iconAlt = "Up";
                            }
                            else if (data.ChangedLevel < 0) {
                                icon = "lruworradrawnwod";
                                iconAlt = "Down";
                            } else {
                                icon = "lruworradrawenillatnoziroh";
                                iconAlt = "Neutral";
                            }

                            <tr style="height: 25px;">
                                <td align="center">@counter</td>
                                <td align="left"><img src="cid:@icon" style="margin: 0 5px 0 2px" alt="@iconAlt"/>@data.Username</td>
                                <td align="center">@data.Level</td>
                                <td align="center">@data.Currency</td>
                                <td align="right">@data.YesterdayBalance</td>
                                <td align="right">@data.TotalBalance</td>
                                <td align="right">@data.MaxLoss</td>
                                <td align="right">@data.LossPercentage%</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
    <p>Regards.</p>
    <p style="font-style: italic; font-weight: bold;">This is an auto-mail. Please do not reply.</p>
</div>